# Postgres (docker-compose.yml exposes this locally)
DATABASE_URL="postgresql://fusionlab:fusionlab@localhost:5432/fusionlab"

# Redis (docker-compose.yml exposes this locally)
REDIS_URL="redis://localhost:6379"

# Firebase Admin SDK — generate a service account key in the fusionlab-acc2d
# Firebase project (Project settings -> Service accounts -> Generate new
# private key), then fill these fields from the downloaded JSON.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Locally, the plain PEM works fine (dotenv expands \n inside double quotes):
FIREBASE_PRIVATE_KEY=""
# On hosting dashboards (Railway/Render/...), prefer this instead — plain
# PEM env vars regularly get mangled by dashboard UIs (quoting/newline
# handling varies), producing "DECODER routines::unsupported" at runtime.
# Base64 is opaque ASCII and can't be corrupted that way:
#   node -e "console.log(Buffer.from(require('dotenv').config({path:'apps/api/.env'}) && process.env.FIREBASE_PRIVATE_KEY.replace(/\\\\n/g,'\n')).toString('base64'))"
# When set, FIREBASE_PRIVATE_KEY_B64 takes priority over FIREBASE_PRIVATE_KEY.
FIREBASE_PRIVATE_KEY_B64=""

# Origins the API accepts browser requests from (CORS). Comma-separated —
# the frontend lives at several origins at once (local dev, Vercel
# production, Vercel preview URLs, the custom domain). Set this on the
# API host (Railway); leaving it unset falls back to localhost:3000 only,
# which silently blocks the deployed frontend.
WEB_ORIGIN="http://localhost:3000"

# apps/web reads this to talk to the API. Set it on the FRONTEND host
# (Vercel) — the NestJS API never reads any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Firebase client config — safe to expose (NEXT_PUBLIC_*), from the same
# fusionlab-acc2d project as the server-side FIREBASE_* vars above.
# Console -> Project settings -> General -> Your apps -> SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="fusionlab-acc2d.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="fusionlab-acc2d"

# LiqPay (Phase 1 — see ROADMAP.md)
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""
