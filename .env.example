# Postgres (docker-compose.yml exposes this locally)
DATABASE_URL="postgresql://fusionlab:fusionlab@localhost:5432/fusionlab"

# Redis (docker-compose.yml exposes this locally)
REDIS_URL="redis://localhost:6379"

# Firebase Admin SDK — generate a service account key in the fusionlab-acc2d
# Firebase project (Project settings -> Service accounts -> Generate new
# private key), then fill these three fields from the downloaded JSON.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# apps/web reads this to talk to the API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Firebase client config — safe to expose (NEXT_PUBLIC_*), from the same
# fusionlab-acc2d project as the server-side FIREBASE_* vars above.
# Console -> Project settings -> General -> Your apps -> SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="fusionlab-acc2d.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="fusionlab-acc2d"

# LiqPay (Phase 1 — see ROADMAP.md)
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""
