generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// buyer/seller/admin are the original three (Phase 1/2). The five added
// for the migration-plan role model (docs/migration-plan.md, Phase A)
// each start with an empty or narrow permission preset — see
// src/auth/permissions.ts for what each one actually grants; the enum
// alone says nothing about capability.
enum UserRole {
  buyer
  seller
  admin
  writer
  expert
  sales_manager
  instruction_engineer
  student
}

enum SellerStatus {
  pending
  approved
  rejected
}

enum ListingKind {
  course
  product
  book
}

// draft -> pending_review -> published is the seller's path; an admin sends
// it on to published or rejected. archived hides a listing from the catalog
// without deleting order history that points at it.
enum ListingStatus {
  draft
  pending_review
  published
  rejected
  archived
}

enum MediaKind {
  cover
  attachment
  video
  // Additional public listing imagery beyond the one cover — a gallery
  // strip on the catalog detail page (docs/migration-plan.md Phase D4).
  // Always `access: public`: these are marketing images, not paid
  // content, so they carry no entitlement gate.
  gallery
}

// public = catalog imagery, served to anyone. entitled = the paid payload
// (course materials, STL files, video), served only to a buyer who owns
// the listing, its seller, or an admin. See MediaService.assertCanDownload.
enum MediaAccess {
  public
  entitled
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
}

enum PaymentStatus {
  pending
  success
  failure
}

enum NotificationType {
  listing_submitted
  listing_approved
  listing_rejected
  order_placed
  order_paid
  seller_application
  seller_approved
  payout_recorded
  referral_bonus
  chat_message
  review_posted
  class_booked
  class_cancelled
  team_invited
  team_submitted
  team_published
  team_rejected
}

// pending -> published is the moderation path (mirrors ListingStatus);
// rejected is terminal — the owner creates a new team rather than editing
// a rejected one back to pending, same reasoning as listings.
enum TeamStatus {
  pending
  published
  rejected
}

enum TeamMemberRole {
  owner
  member
}

// invited -> confirmed (accepted) or declined. A declined slot frees the
// seat it reserved on Team.memberCount; a confirmed one keeps it — the
// seat was already reserved at invite time, not at confirmation time, so
// the cap can't be oversold by inviting more people than seats remain.
enum TeamMemberStatus {
  invited
  confirmed
  declined
}

enum PromoCodeType {
  percent
  fixed
}

// Positive points = credit (earned), negative = debit (spent). Kept as a
// signed ledger rather than a running balance column so "how did I end up
// with 1200 points" always has an answer — see LoyaltyAccount.balance,
// which is a cached sum of these rows, not a separate source of truth.
enum LoyaltyTransactionType {
  earned_purchase
  earned_referral
  spent_order
  admin_adjustment
}

// Identity lives in Firebase Auth (email/password + Google). This table
// holds domain data keyed by the Firebase UID - created lazily on first
// authenticated request. See docs/adr/0002-postgres-over-firestore.md.
model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  email       String   @unique
  displayName String?
  role        UserRole @default(buyer)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Set the first (and, per the migration plan, only) time a user chooses
  // their own role via POST /me/role. A fresh Firebase sign-in creates the
  // row with the schema default (buyer) before the person has picked
  // anything — this timestamp is what tells "hasn't chosen yet" apart from
  // "chose buyer on purpose", and is what POST /me/role checks to refuse a
  // second, silent self-reassignment. Admin's PATCH /admin/users/:id/role
  // is unaffected — it does not touch this field.
  roleChosenAt DateTime?

  // Gates the `sales:access` permission regardless of role preset (see
  // src/auth/permissions.ts). Exists because a role picked freely at
  // signup (roleChosenAt above) must not itself grant access to other
  // sellers' orders/cart data — an admin has to turn this on first, the
  // same trust boundary SellerProfile.status already enforces for sellers.
  salesApproved Boolean @default(false)

  // Stable, unique, short — handed out at account creation so a referral
  // link exists from a user's very first session, before they've done
  // anything else worth linking to. See ReferralsService.
  referralCode String @unique

  sellerProfile       SellerProfile?
  cart                Cart?
  orders              Order[]
  entitlements        Entitlement[]
  notifications       Notification[]
  uploads             MediaAsset[]              @relation("MediaUploader")
  threads             AssistantThread[]
  loyaltyAccount      LoyaltyAccount?
  reviews             Review[]
  permissionOverrides UserPermissionOverride[]
  lessonProgress      LessonProgress[]
  classBookings       ClassBooking[]
  ownedTeams          Team[]                    @relation("TeamOwner")
  teamMemberships     TeamMember[]

  // A referral is a fact about two users, not one — kept as two named
  // relations so "who referred me" and "who I referred" are both direct
  // queries instead of a self-join with a role column.
  referralsMade     Referral[] @relation("ReferralsMade")
  referralReceived  Referral?  @relation("ReferralReceived")

  chatThreadsAsBuyer  ChatThread[]  @relation("ChatThreadsAsBuyer")
  chatThreadsAsSeller ChatThread[]  @relation("ChatThreadsAsSeller")
  chatMessages        ChatMessage[]
}

// Point exceptions to the static role -> permission presets in
// src/auth/permissions.ts. `granted: false` revokes something the role
// preset would otherwise give (e.g. suspending one writer's sales
// access without changing their role); `granted: true` adds something
// their role preset doesn't. One row per (user, permission) — a second
// PATCH for the same permission replaces the first rather than stacking.
model UserPermissionOverride {
  id         String   @id @default(uuid())
  userId     String
  permission String
  granted    Boolean
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model SellerProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  displayName String
  slug        String       @unique
  bio         String?
  status      SellerStatus @default(pending)
  // Marketplace's cut, applied per order item at checkout and frozen into
  // OrderItem.commissionMinor so a later rate change cannot rewrite history.
  commissionPercent Int    @default(15)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
  payouts  Payout[]
}

model Category {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     String
  listings Listing[]
}

model Listing {
  id       String        @id @default(uuid())
  slug     String        @unique
  sellerId String
  kind     ListingKind
  status   ListingStatus @default(draft)

  title       String
  subtitle    String?
  summary     String?
  description String?
  highlights  String[] @default([])
  // Course modules/lessons as authored - deeply nested, read whole, never
  // queried field by field. A JSON column keeps it in one row instead of
  // three join tables that would only ever be selected together.
  curriculum  Json?

  // Money is stored in minor units (kopecks) - integers only, so no float
  // rounding can creep into a total. Formatting happens at the edge.
  priceMinor Int
  currency   String @default("UAH")

  coverUrl   String?
  stock      Int?
  categoryId String?

  // Book listings are mirrored from Book_Creality through the bridge API;
  // this pair identifies the upstream record so re-publishing updates the
  // same listing instead of creating duplicates. See ADR 0001.
  externalSource String?
  externalId     String?

  // Maintained by Postgres as a STORED generated column (see the
  // phase1_marketplace migration). Declared here only so Prisma does not
  // read the column as drift and try to drop it; nothing writes to it.
  searchVector Unsupported("tsvector")?

  publishedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller          SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id])
  media           MediaAsset[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  entitlements    Entitlement[]
  reviews         Review[]
  chatThreads     ChatThread[]
  lessonProgress  LessonProgress[]

  @@unique([externalSource, externalId])
  @@index([status, kind])
  @@index([sellerId])
}

// One row per lesson a buyer has marked watched. Lessons live inside
// Listing.curriculum's JSON (see the comment on that field) with no
// database id of their own, so a lesson is addressed by its position —
// (moduleIndex, lessonIndex) — rather than a foreign key. Positions are
// stable in practice: a seller reordering a published course's curriculum
// is exactly as disruptive to progress tracking as it is to a buyer
// halfway through, which is an acceptable, narrow trade-off for not
// needing three extra join tables for content that is read whole and
// never queried lesson-by-lesson anywhere else in the schema.
model LessonProgress {
  id          String   @id @default(uuid())
  userId      String
  listingId   String
  moduleIndex Int
  lessonIndex Int
  completedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId, moduleIndex, lessonIndex])
}

model MediaAsset {
  id         String      @id @default(uuid())
  listingId  String?
  // A team's photo/result files (Phase F1) reuse this same table rather
  // than a parallel one — `cover`/`attachment` already mean exactly "the
  // one public photo" / "any number of files", which is all a team needs.
  // Exactly one of listingId/teamId is set; never both.
  teamId     String?
  uploaderId String
  kind       MediaKind
  access     MediaAccess @default(entitled)
  filename   String
  mimeType   String
  sizeBytes  Int
  // Opaque key handed to the storage driver - a relative path on disk
  // today, an object key in S3 later. Never a URL: what serves the bytes
  // is the driver's business, not the database's.
  storageKey    String
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  listing  Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  team     Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploader User     @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([teamId])
}

// Phase F1 (docs/migration-plan.md) — up to 5 people (owner included)
// working on one shared lab project, published to the public catalog only
// after admin moderation. Deliberately without the "active team
// subscription" badge from the original page: that requires the
// subscription model from Phase E, which was skipped, and a team list with
// a badge nobody's account can ever earn is worse than one without it —
// see the migration plan's Phase F notes.
model Team {
  id              String     @id @default(uuid())
  name            String     @unique
  direction       String?
  description     String
  status          TeamStatus @default(pending)
  rejectionReason String?
  ownerId         String
  // Denormalized, guarded counter — same reason ClassSchedule.bookedCount
  // exists: an invite has to be an atomic guarded UPDATE ("only succeed if
  // memberCount < 5") to survive two invites racing for the last seat, and
  // that guard needs a column on THIS row to check against in the same
  // statement. Starts at 1 (the owner).
  memberCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TeamMember[]
  media   MediaAsset[]

  @@index([status, createdAt])
}

model TeamMember {
  id          String           @id @default(uuid())
  teamId      String
  userId      String
  role        TeamMemberRole   @default(member)
  status      TeamMemberStatus @default(invited)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  listingId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
}

model Order {
  id       String      @id @default(uuid())
  number   String      @unique
  buyerId  String
  status   OrderStatus @default(pending)
  currency String      @default("UAH")

  subtotalMinor   Int
  totalMinor      Int
  commissionMinor Int @default(0)

  // Both discounts are marketplace-absorbed, not deducted from what the
  // seller earns: OrderItem.unitPriceMinor/commissionMinor are untouched
  // by either, so a promo run or a buyer spending points never changes a
  // seller's payout math. Frozen at checkout for the same reason prices
  // are snapshotted onto OrderItem — a promo code edited or deleted later
  // must not reinterpret an old order's total.
  promoCodeId          String?
  promoDiscountMinor   Int     @default(0)
  loyaltyPointsSpent   Int     @default(0)
  loyaltyDiscountMinor Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  buyer               User                 @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  promoCode           PromoCode?           @relation(fields: [promoCodeId], references: [id])
  items               OrderItem[]
  payment             Payment?
  entitlements        Entitlement[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([buyerId, status])
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  listingId String
  sellerId  String

  // Snapshots: an order line must keep reading correctly after the seller
  // renames or reprices the listing it points at.
  titleSnapshot   String
  kind            ListingKind
  unitPriceMinor  Int
  quantity        Int         @default(1)
  commissionMinor Int         @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([sellerId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  provider          String        @default("liqpay")
  status            PaymentStatus @default(pending)
  providerPaymentId String?
  amountMinor       Int
  currency          String        @default("UAH")
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// The permanent record of "this user owns this listing" - what gates
// downloads and course access. Separate from OrderItem because an
// entitlement can also be granted without a purchase (admin grant, gift).
model Entitlement {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  orderId   String?
  grantedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([userId, listingId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AssistantThread {
  id        String   @id @default(uuid())
  userId    String?
  createdAt DateTime @default(now())

  user     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AssistantMessage[]
}

model AssistantMessage {
  id        String   @id @default(uuid())
  threadId  String
  role      String
  content   String
  createdAt DateTime @default(now())

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// One record per payout event. The seller's outstanding balance is never
// stored — it is always (paid OrderItem earnings) minus (sum of these
// rows), computed on read by PayoutsService. A stored balance column would
// be a second source of truth that a missed update could silently
// desync from the order history it is supposed to summarize.
model Payout {
  id          String   @id @default(uuid())
  sellerId    String
  amountMinor Int
  note        String?
  // Optional reporting window ("виплата за визначений період" in
  // CONTEXT.md) — purely descriptive, not used to select which orders are
  // covered. The balance calculation has no notion of periods; an admin
  // just records what was actually transferred and when.
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
}

model PromoCode {
  id   String        @id @default(uuid())
  code String        @unique
  type PromoCodeType
  // percent: 1-100 (%); fixed: minor units off the subtotal.
  value           Int
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  orders Order[]
}

// One row per user; the running total is a cache of the ledger below, kept
// for a cheap read on every checkout screen. LoyaltyService.recompute()
// exists precisely so this cache is never trusted blindly — see its
// comment for when that matters.
model LoyaltyAccount {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String                 @id @default(uuid())
  accountId String
  type      LoyaltyTransactionType
  // Signed: positive on earn, negative on spend. The account balance is
  // literally the sum of this column for the account — see the model
  // comment on LoyaltyAccount.
  points    Int
  orderId   String?
  note      String?
  createdAt DateTime               @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id])

  @@index([accountId, createdAt])
}

// The flagship domain model — see docs/adr/0005-referral-program.md for
// the full reasoning. One row per *referred* user (@unique on referredId):
// a person can only ever have been invited by one other person, which is
// also what makes "did I already claim a code" a single lookup rather
// than a query needing an ORDER BY / LIMIT 1.
model Referral {
  id           String    @id @default(uuid())
  referrerId   String
  referredId   String    @unique
  bonusAwarded Boolean   @default(false)
  awardedAt    DateTime?
  createdAt    DateTime  @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

// One review per (listing, user) — enforced by the unique constraint, not
// just application logic, so a race between two tabs submitting "edit my
// review" at once can't produce two rows. Eligibility (must have bought
// the listing) is checked in ReviewsService since it needs a join Prisma's
// schema can't express as a constraint.
model Review {
  id        String   @id @default(uuid())
  listingId String
  userId    String
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([listingId])
}

// One thread per (listing, buyer) pair — the seller side is implied by the
// listing, so two buyers asking about the same listing never collide, and
// a buyer re-opening the chat about a listing they already messaged about
// lands back in the same thread instead of starting a fresh one.
model ChatThread {
  id        String   @id @default(uuid())
  listingId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing  Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User          @relation("ChatThreadsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User          @relation("ChatThreadsAsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([listingId, buyerId])
  @@index([sellerId])
}

model ChatMessage {
  id        String    @id @default(uuid())
  threadId  String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// Phase F2 (docs/migration-plan.md) — real, capacity-checked booking for
// the lab's own offline sessions. `direction` is a free-text label
// ("Робототехніка", "Меблярство"), deliberately not a foreign key to
// Category: a class direction and a marketplace listing category are
// conceptually different things that happen to share vocabulary, and
// tying them together would make a schedule change contingent on catalog
// taxonomy changes for no benefit either side needs today.
enum ScheduleStatus {
  scheduled
  cancelled
}

model ClassSchedule {
  id          String         @id @default(uuid())
  title       String
  description String?
  direction   String?
  startsAt    DateTime
  capacity    Int
  // Denormalized counter, not COUNT(*) on ClassBooking, for the same
  // reason PromoCode.redemptionCount exists: booking has to be an atomic
  // guarded UPDATE ("only succeed if bookedCount < capacity") to survive
  // two people booking the last seat at once, and that guard needs a
  // column on THIS row to check against in the same statement.
  bookedCount Int            @default(0)
  status      ScheduleStatus @default(scheduled)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  bookings ClassBooking[]

  @@index([status, startsAt])
}

enum BookingStatus {
  confirmed
  cancelled
}

model ClassBooking {
  id         String        @id @default(uuid())
  scheduleId String
  userId     String
  status     BookingStatus @default(confirmed)
  createdAt  DateTime      @default(now())

  schedule ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per (user, schedule) ever, not one per active booking: a
  // cancelled booking flips `status` rather than being deleted, so a
  // second book-then-cancel-then-book cycle updates the same row instead
  // of colliding with a leftover cancelled one.
  @@unique([scheduleId, userId])
}
